# 서버 포트
PORT=8080

# 관리자 API 키 (아이디 발급 등 관리자 기능 인증용). 반드시 긴 랜덤 문자열로 교체하세요.
ADMIN_KEY=change-me-to-a-long-random-string

# SQLite 파일 경로
DB_PATH=./data/secretcall.db

# 등록코드/토큰 길이 등 보안 파라미터 (기본값 유지 권장)
REGISTRATION_CODE_BYTES=6
AUTH_TOKEN_BYTES=32

# 앱에 내려줄 ICE 서버 설정 (STUN/TURN). 콤마로 여러 개 지정 가능.
STUN_URLS=stun:stun.l.google.com:19302
# 예: turn:call.example.com:3478
TURN_URLS=

# ── TURN 인증 (택1) ──
# 방식 A(권장): 시간제한 임시 자격증명. coturn 의 static-auth-secret 과 반드시 동일하게!
#   긴 랜덤 문자열로 교체하세요. 설정 시 앱에는 10분짜리 자격증명이 발급됩니다.
TURN_STATIC_SECRET=
TURN_TTL_SECONDS=600
# 방식 B(대체): 고정 자격증명 (방식 A 를 비워둔 경우에만 사용)
TURN_USERNAME=
TURN_CREDENTIAL=

# ── 프라이버시 ──
# 접근 로그. 프라이버시를 위해 기본 비활성화(사용자·IP·경로 미기록).
# 디버깅이 꼭 필요할 때만 1 로 설정(메서드+경로 최소 기록). 평소엔 비워두세요.
ACCESS_LOG=

# ── 수신 알림(푸시) ── (미설정 시 푸시 없이 동작. 설정법: docs/PUSH_SETUP.md)
# 오프라인 상대의 통화 offer 버퍼 유지 시간(ms)
PENDING_CALL_TTL_MS=45000

# Android FCM (HTTP v1)
FCM_PROJECT_ID=
FCM_SERVICE_ACCOUNT_FILE=./secrets/fcm-service-account.json

# iOS APNs VoIP 푸시 (PushKit)
APNS_KEY_FILE=./secrets/AuthKey_XXXX.p8
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_BUNDLE_ID=com.example.secretcall
APNS_PRODUCTION=false
